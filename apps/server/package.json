{
  "name": "@inventur/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=dev.env --watch --watch-preserve-output src/index.ts",
    "start": "node src/index.ts",
    "seed": "node --env-file-if-exists=dev.env src/cli/seed-master-data.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.3.1",
    "@inventur/shared": "workspace:*",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.0"
  }
}
