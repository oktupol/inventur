# IP-Adresse oder Hostname des Servers im LAN. Wird für QR-Codes und das
# HTTPS-Zertifikat der Smartphones benötigt.
PUBLIC_HOST=192.168.1.10

# Passwort der Postgres-Datenbank. Bitte ein eigenes, langes Passwort wählen.
POSTGRES_PASSWORD=bitte-aendern

# Version des Anwendungs-Images (Tag in ghcr.io/oktupol/inventur-app).
# Ab Release 1.0 steht hier eine feste Version, z. B. v1.0.0.
APP_VERSION=latest
