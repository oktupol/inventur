# IP address or host name of the server in the LAN. Used for QR codes and the
# HTTPS certificate for smartphones.
PUBLIC_HOST=192.168.1.10

# Password of the Postgres database. Choose a long, unique password.
POSTGRES_PASSWORD=change-me

# Version of the application image (tag of ghcr.io/oktupol/inventur-app).
# From release 1.0 on, this is a fixed version such as v1.0.0.
APP_VERSION=latest

# Time zone of the times in exports and PDFs (default Europe/Berlin).
# TZ=Europe/Berlin
